<?xml version="1.0" encoding="utf-8"?>
<!--
    Estilos de la pantalla de Ajustes, replicando el diseno de Via.

    Rasgos tomados de las capturas reales de Via:
      - Fondo BLANCO, no oscuro.
      - Filas SIN icono: solo el texto a la izquierda, alineado a 16dp del borde.
      - Las filas de navegacion llevan ">" a la derecha.
      - Las filas con interruptor llevan un punto/switch a la derecha.
      - Titulo + subtitulo gris pequeÃƒÂ±o debajo.
      - Separacion generosa entre filas (Via usa ~72dp de alto por fila).
      - Cabecera: flecha "<" + titulo en negrita, con linea separadora debajo.
-->
<resources>

    <!-- ================== CABECERA ================== -->

    <style name="ViaSetupHeader">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">64dp</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:orientation">horizontal</item>
        <item name="android:paddingStart">8dp</item>
        <item name="android:paddingEnd">16dp</item>
    </style>

    <!-- Flecha "<" de volver -->
    <style name="ViaSetupBack">
        <item name="android:layout_width">52dp</item>
        <item name="android:layout_height">52dp</item>
        <item name="android:layout_marginEnd">8dp</item>
        <item name="android:background">@drawable/bg_setup_item</item>
        <item name="android:contentDescription">@string/settings_back</item>
        <item name="android:focusable">true</item>
        <item name="android:focusableInTouchMode">false</item>
        <item name="android:padding">14dp</item>
        <item name="android:scaleType">fitCenter</item>
        <item name="android:tint">@color/setup_text</item>
    </style>

    <style name="ViaSetupTitle">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">@color/setup_text</item>
        <item name="android:textSize">19sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <!-- ================== FILAS ================== -->

    <!--
        Fila con ">" (navega a otra pantalla).
        Alto minimo 72dp y sin icono, como Via. El texto empieza a 16dp.
    -->
    <style name="ViaSetupNavRow">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:minHeight">72dp</item>
        <item name="android:background">@drawable/bg_setup_item</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
        <item name="android:focusableInTouchMode">false</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:orientation">horizontal</item>
        <item name="android:paddingStart">16dp</item>
        <item name="android:paddingTop">14dp</item>
        <item name="android:paddingEnd">16dp</item>
        <item name="android:paddingBottom">14dp</item>
    </style>

    <!-- Fila con interruptor (si/no) -->
    <style name="ViaSetupToggleRow">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:minHeight">72dp</item>
        <item name="android:background">@drawable/bg_setup_item</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
        <item name="android:focusableInTouchMode">false</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:orientation">horizontal</item>
        <item name="android:paddingStart">16dp</item>
        <item name="android:paddingTop">14dp</item>
        <item name="android:paddingEnd">16dp</item>
        <item name="android:paddingBottom">14dp</item>
    </style>

    <style name="ViaSetupRowText">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:orientation">vertical</item>
    </style>

    <style name="ViaSetupRowTitle">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">@color/setup_text</item>
        <item name="android:textSize">16sp</item>
    </style>

    <style name="ViaSetupRowSummary">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">2dp</item>
        <item name="android:textColor">@color/setup_text_secondary</item>
        <item name="android:textSize">13sp</item>
    </style>

    <!-- ">" al final de las filas de navegacion -->
    <style name="ViaSetupChevron">
        <item name="android:layout_width">20dp</item>
        <item name="android:layout_height">20dp</item>
        <item name="android:layout_marginStart">12dp</item>
        <item name="android:contentDescription">@null</item>
        <item name="android:scaleType">fitCenter</item>
        <item name="android:src">@drawable/ic_chevron</item>
        <item name="android:tint">@color/setup_text_hint</item>
    </style>

    <!-- Valor a la derecha de las filas de navegacion ("Cloudflare 1.1.1.1") -->
    <style name="ViaSetupRowValue">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginStart">12dp</item>
        <item name="android:ellipsize">end</item>
        <item name="android:maxWidth">260dp</item>
        <item name="android:singleLine">true</item>
        <item name="android:textColor">@color/setup_accent</item>
        <item name="android:textSize">14sp</item>
    </style>

    <!-- Boton de texto de la cabecera (ACTUALIZAR) -->
    <style name="ViaSetupHeaderAction">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">48dp</item>
        <item name="android:layout_marginStart">8dp</item>
        <item name="android:background">@drawable/bg_setup_item</item>
        <item name="android:focusable">true</item>
        <item name="android:focusableInTouchMode">false</item>
        <item name="android:gravity">center</item>
        <item name="android:minWidth">72dp</item>
        <item name="android:paddingStart">14dp</item>
        <item name="android:paddingEnd">14dp</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:textColor">@color/setup_accent</item>
        <item name="android:textSize">13sp</item>
    </style>

    <!-- Punto de estado (interruptor): relleno = activo, hueco = apagado -->
    <style name="ViaSetupSwitch">
        <item name="android:layout_width">22dp</item>
        <item name="android:layout_height">22dp</item>
        <item name="android:layout_marginStart">12dp</item>
        <item name="android:contentDescription">@null</item>
    </style>

    <!-- ================== TEXTOS AUXILIARES ================== -->

    <!-- Cabecera de grupo dentro de una lista ("Suscripciones de filtros") -->
    <style name="ViaSetupGroupLabel">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:paddingStart">16dp</item>
        <item name="android:paddingTop">20dp</item>
        <item name="android:paddingEnd">16dp</item>
        <item name="android:paddingBottom">10dp</item>
        <item name="android:textColor">@color/setup_accent</item>
        <item name="android:textSize">13sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="ViaSetupDivider">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">1dp</item>
        <item name="android:layout_marginStart">16dp</item>
        <item name="android:background">@color/setup_divider</item>
    </style>

</resources>
