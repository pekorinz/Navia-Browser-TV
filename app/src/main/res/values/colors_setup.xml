<?xml version="1.0" encoding="utf-8"?>
<!--
    Paleta clara de ajustes inspirada en las referencias de Via.
    El color del foco se mantiene visible para el uso con D-pad.
-->
<resources>

    <!-- Fondos -->
    <color name="setup_bg">#FFFFFF</color>
    <color name="setup_surface">#F7F7F8</color>

    <!-- Texto -->
    <color name="setup_text">#202124</color>
    <color name="setup_text_secondary">#5F6368</color>
    <color name="setup_text_hint">#777B80</color>

    <!-- Acento -->
    <color name="setup_accent">#5874D8</color>
    <color name="setup_accent_dim">#405DBF</color>

    <!-- Lineas -->
    <color name="setup_divider">#D9DADD</color>

    <!-- Foco con D-pad: contorno dorado TV y fondo destacado -->
    <color name="setup_focus_bg">#FFF7ED</color>
    <color name="setup_focus_stroke">#E98516</color>

</resources>
