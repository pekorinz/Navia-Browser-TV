<?xml version="1.0" encoding="utf-8"?>
<!--
    Menu rapido emergente, estilo Via "blanco".

    Reproduce el menu real de Via: tarjeta blanca redondeada que baja desde
    arriba, con una rejilla de iconos negro + etiqueta, y arriba a la derecha
    el encendido y el chevron para cerrar.

    Adaptado a TV:
      - Ancho fijo en dp, no wrap_content: con wrap_content el panel crecia
        hasta el ancho de la TV y las etiquetas quedaban lejisimos de sus iconos.
      - Compacto a proposito, pero legible a 3 metros: iconos de 25dp y
        etiquetas de 11sp.
      - Pegado al borde derecho (gravity top|end), bajo el boton del sandwich.
      - Foco: el aislamiento NO se hace con descendantFocusability. Ojo con
        blocksDescendants en el overlay: no encierra el foco en los iconos,
        BLOQUEA a todos sus descendientes (menus enteros sin poder enfocarse).
        Aqui el overlay usa afterDescendants y el encierro real lo hace
        MainActivity: apaga la pagina de atras y navega la rejilla a mano.
      - La navegacion del D-pad la hace MainActivity a mano (moveFocusInGrid),
        no el sistema: asi el foco no puede saltar a la pagina de atras.
      - Rejilla de 4 columnas en vez de 5: en TV se ve a 3 metros.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/quickMenuOverlay"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#99000000"
    android:clickable="true"
    android:descendantFocusability="afterDescendants"
    android:focusable="false"
    android:gravity="top|end"
    android:orientation="vertical"
    android:paddingTop="10dp"
    android:paddingEnd="12dp"
    android:visibility="gone">

    <!--
        Ancho fijo en dp. En TV, 1dp ~ 1px (dpi de televisor), asi que 391dp
        son ~391px en 1080p. Pegado al borde derecho (gravity top|end), como el
        panel de Via cuando se abre desde el boton de la derecha de la barra.
        No se usa 'mu' (min-units): esa unidad solo existe en codigo, aapt2 la
        rechaza en XML ("incompatible with attribute layout_width").
    -->
    <LinearLayout
        android:layout_width="391dp"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_quick_menu"
        android:orientation="vertical"
        android:paddingStart="10dp"
        android:paddingTop="2dp"
        android:paddingEnd="10dp"
        android:paddingBottom="4dp">

        <!-- Barra superior del menu: encendido a la izquierda, cerrar a la derecha -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageButton
                android:id="@+id/qmPower"
                style="@style/QuickMenuItem"
                android:contentDescription="@string/btn_exit_menu"
                android:src="@drawable/ic_menu_power"
                android:tint="@color/qm_icon" />

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <ImageButton
                android:id="@+id/qmClose"
                style="@style/QuickMenuItem"
                android:contentDescription="@string/dialog_cancel"
                android:rotation="90"
                android:src="@drawable/ic_chevron_right"
                android:tint="@color/qm_icon" />
        </LinearLayout>

        <!-- Separador tenue -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="2dp"
            android:layout_marginBottom="2dp"
            android:background="@color/qm_divider" />

        <!-- Fila 1 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <LinearLayout
                android:id="@+id/qmNight"
                style="@style/QuickMenuCell">
                <ImageView style="@style/QuickMenuIcon" android:src="@drawable/ic_menu_night" />
                <TextView style="@style/QuickMenuLabel" android:text="@string/qm_night" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/qmBookmarks"
                style="@style/QuickMenuCell">
                <ImageView style="@style/QuickMenuIcon" android:src="@drawable/ic_menu_bookmarks" />
                <TextView style="@style/QuickMenuLabel" android:text="@string/qm_bookmarks" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/qmHistory"
                style="@style/QuickMenuCell">
                <ImageView style="@style/QuickMenuIcon" android:src="@drawable/ic_menu_history" />
                <TextView style="@style/QuickMenuLabel" android:text="@string/qm_history" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/qmDownloads"
                style="@style/QuickMenuCell">
                <ImageView style="@style/QuickMenuIcon" android:src="@drawable/ic_menu_downloads" />
                <TextView style="@style/QuickMenuLabel" android:text="@string/qm_downloads" />
            </LinearLayout>
        </LinearLayout>

        <!-- Fila 2 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <LinearLayout
                android:id="@+id/qmIncognito"
                style="@style/QuickMenuCell">
                <ImageView style="@style/QuickMenuIcon" android:src="@drawable/ic_menu_incognito" />
                <TextView style="@style/QuickMenuLabel" android:text="@string/qm_incognito" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/qmAddBookmark"
                style="@style/QuickMenuCell">
                <ImageView style="@style/QuickMenuIcon" android:src="@drawable/ic_menu_addbookmark" />
                <TextView style="@style/QuickMenuLabel" android:text="@string/qm_add_bookmark" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/qmDesktop"
                style="@style/QuickMenuCell">
                <ImageView style="@style/QuickMenuIcon" android:src="@drawable/ic_menu_desktop" />
                <TextView style="@style/QuickMenuLabel" android:text="@string/qm_desktop" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/qmTools"
                style="@style/QuickMenuCell">
                <ImageView style="@style/QuickMenuIcon" android:src="@drawable/ic_menu_tools" />
                <TextView style="@style/QuickMenuLabel" android:text="@string/qm_tools" />
            </LinearLayout>
        </LinearLayout>

        <!-- Fila 3 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <LinearLayout
                android:id="@+id/qmSettings"
                style="@style/QuickMenuCell">
                <ImageView style="@style/QuickMenuIcon" android:src="@drawable/ic_menu_settings" />
                <TextView style="@style/QuickMenuLabel" android:text="@string/qm_settings" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/qmShare"
                style="@style/QuickMenuCell">
                <ImageView style="@style/QuickMenuIcon" android:src="@drawable/ic_menu_share" />
                <TextView style="@style/QuickMenuLabel" android:text="@string/qm_share" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/qmFindInPage"
                style="@style/QuickMenuCell">
                <ImageView style="@style/QuickMenuIcon" android:src="@drawable/ic_menu_search" />
                <TextView style="@style/QuickMenuLabel" android:text="@string/qm_find" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/qmTabs"
                style="@style/QuickMenuCell">
                <ImageView style="@style/QuickMenuIcon" android:src="@drawable/ic_menu_tabs" />
                <TextView style="@style/QuickMenuLabel" android:text="@string/qm_tabs" />
            </LinearLayout>
        </LinearLayout>

    </LinearLayout>

</LinearLayout>
