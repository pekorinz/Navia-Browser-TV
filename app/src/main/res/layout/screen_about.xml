<?xml version="1.0" encoding="utf-8"?>
<!--
    Ajustes > Acerca de.  Datos reales, nada escrito a mano.

      <  Acerca de
      
      Navia Browser TV
      Version 1.0
      
      Reglas cargadas            3087 integradas + 94700 suscritas
      Filtros suscritos                        2 listas
      Anuncios bloqueados                          16914
      DNS activo                     Cloudflare 1.1.1.1
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/aboutScreen"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/setup_bg"
    android:orientation="vertical"
    android:visibility="gone">

    <include
        android:id="@+id/aboutHeader"
        layout="@layout/include_setup_header" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/setup_divider" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="24dp">

            <!-- Bloque de presentacion -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="16dp"
                android:paddingTop="24dp"
                android:paddingEnd="16dp"
                android:paddingBottom="20dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/about_app_name"
                    android:textColor="@color/setup_text"
                    android:textSize="22sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvAboutVersion"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:textColor="@color/setup_text_secondary"
                    android:textSize="14sp" />
            </LinearLayout>

            <View style="@style/ViaSetupDivider" />

            <!-- Filas de datos (solo lectura: no son enfocables) -->
            <LinearLayout
                style="@style/ViaSetupNavRow"
                android:clickable="false"
                android:focusable="false">

                <LinearLayout style="@style/ViaSetupRowText">

                    <TextView
                        style="@style/ViaSetupRowTitle"
                        android:text="@string/about_rules" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tvAboutRules"
                    style="@style/ViaSetupRowValue" />
            </LinearLayout>

            <View style="@style/ViaSetupDivider" />

            <LinearLayout
                style="@style/ViaSetupNavRow"
                android:clickable="false"
                android:focusable="false">

                <LinearLayout style="@style/ViaSetupRowText">

                    <TextView
                        style="@style/ViaSetupRowTitle"
                        android:text="@string/about_subs" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tvAboutSubs"
                    style="@style/ViaSetupRowValue" />
            </LinearLayout>

            <View style="@style/ViaSetupDivider" />

            <LinearLayout
                style="@style/ViaSetupNavRow"
                android:clickable="false"
                android:focusable="false">

                <LinearLayout style="@style/ViaSetupRowText">

                    <TextView
                        style="@style/ViaSetupRowTitle"
                        android:text="@string/about_blocked" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tvAboutBlocked"
                    style="@style/ViaSetupRowValue" />
            </LinearLayout>

            <View style="@style/ViaSetupDivider" />

            <LinearLayout
                style="@style/ViaSetupNavRow"
                android:clickable="false"
                android:focusable="false">

                <LinearLayout style="@style/ViaSetupRowText">

                    <TextView
                        style="@style/ViaSetupRowTitle"
                        android:text="@string/about_dns" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tvAboutDns"
                    style="@style/ViaSetupRowValue" />
            </LinearLayout>

        </LinearLayout>
    </ScrollView>

</LinearLayout>
