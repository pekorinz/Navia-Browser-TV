<?xml version="1.0" encoding="utf-8"?>
<!--
    Fondo de una fila de Ajustes (diseno Via).

    En reposo es transparente: el blanco lo pone la pantalla. Al enfocar con
    el D-pad se pinta gris claro con un contorno azul de 2dp, que es la forma
    en que Via deja claro que una fila esta seleccionada.
-->
<selector xmlns:android="http://schemas.android.com/apk/res/android">

    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/setup_focus_bg" />
            <stroke
                android:width="2dp"
                android:color="@color/setup_focus_stroke" />
        </shape>
    </item>

    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/setup_focus_bg" />
        </shape>
    </item>

    <item>
        <shape android:shape="rectangle">
            <solid android:color="@android:color/transparent" />
        </shape>
    </item>

</selector>
