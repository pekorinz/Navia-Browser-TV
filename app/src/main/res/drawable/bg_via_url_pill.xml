<?xml version="1.0" encoding="utf-8"?>
<!-- Pildora de la barra de URL, igual que la de Via pero con contorno visible en TV -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <corners android:radius="24dp" />
            <solid android:color="@color/via_surface_alt" />
            <stroke
                android:width="2dp"
                android:color="@color/via_focus_ring" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="24dp" />
            <solid android:color="@color/via_surface" />
            <stroke
                android:width="1dp"
                android:color="@color/via_separator" />
        </shape>
    </item>
</selector>
