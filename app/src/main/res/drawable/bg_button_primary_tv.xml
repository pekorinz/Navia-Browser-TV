<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Foco con el control remoto en TV -->
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <corners android:radius="14dp" />
            <solid android:color="@color/setup_focus_bg" />
            <stroke
                android:width="2.5dp"
                android:color="@color/setup_focus_stroke" />
        </shape>
    </item>
    <!-- Presionado -->
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <corners android:radius="14dp" />
            <solid android:color="@color/setup_accent_dim" />
        </shape>
    </item>
    <!-- Normal: boton acento suave -->
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="14dp" />
            <solid android:color="#EEF3FF" />
            <stroke
                android:width="1.5dp"
                android:color="@color/setup_accent" />
        </shape>
    </item>
</selector>
