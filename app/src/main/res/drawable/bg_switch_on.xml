<?xml version="1.0" encoding="utf-8"?>
<!-- Interruptor ENCENDIDO: capsula moderna para Android TV con boton blanco deslizante -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Pista de la capsula (Track ON) -->
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="14dp" />
            <solid android:color="@color/setup_accent" />
            <size
                android:width="50dp"
                android:height="28dp" />
        </shape>
    </item>
    <!-- Perilla/Knob deslizante blanca a la derecha -->
    <item
        android:width="22dp"
        android:height="22dp"
        android:gravity="end|center_vertical"
        android:right="3dp">
        <shape android:shape="oval">
            <solid android:color="#FFFFFF" />
        </shape>
    </item>
</layer-list>
