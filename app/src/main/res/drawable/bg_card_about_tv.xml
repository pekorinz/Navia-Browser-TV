<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Foco con mando a distancia de TV -->
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <corners android:radius="16dp" />
            <solid android:color="@color/setup_focus_bg" />
            <stroke
                android:width="2.5dp"
                android:color="@color/setup_focus_stroke" />
        </shape>
    </item>
    <!-- Estado normal: tarjeta limpia con sombra/borde sutil -->
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="16dp" />
            <solid android:color="#F8FAFC" />
            <stroke
                android:width="1.2dp"
                android:color="#E2E8F0" />
        </shape>
    </item>
</selector>
