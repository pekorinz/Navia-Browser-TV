<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Enfocado por el D-Pad en TV: borde dorado vivo y fondo de realce -->
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <corners android:radius="12dp" />
            <solid android:color="@color/setup_focus_bg" />
            <stroke
                android:width="2.5dp"
                android:color="@color/setup_focus_stroke" />
        </shape>
    </item>
    <!-- Pestaña seleccionada actualmente: borde acento y fondo suave -->
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <corners android:radius="12dp" />
            <solid android:color="#EEF3FF" />
            <stroke
                android:width="1.5dp"
                android:color="@color/setup_accent" />
        </shape>
    </item>
    <!-- Estado normal: tarjeta suave con contorno sutil -->
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="12dp" />
            <solid android:color="#FAFAFB" />
            <stroke
                android:width="1dp"
                android:color="@color/setup_divider" />
        </shape>
    </item>
</selector>
